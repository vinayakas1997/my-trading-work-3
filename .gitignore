# Anchored with a leading ** since these live under vinu-components/, not
# the repo root -- a bare "data/models/" only matches <root>/data/models/
# and was silently not matching, letting multi-GB model downloads and
# throwaway venvs show up as untracked instead of being ignored.
**/data/simulator/simulations/
**/data/models/
# Hindsight (docker-compose-hindsight.yml): Postgres binary data dir and
# the downloaded GGUF model weight file -- same "regenerable/too large to
# commit" reasoning as the two lines above.
**/data/hindsight/pg_data/
**/hindsight-llm/models/*.gguf

# --- Logs / generated output ---
logs/
output/
catboost_info/
.writetest

# --- Kilo ---
.kilo

# --- Cloned third-party repos for research (2.6G, each has its own .git) ---
other-repos-world/repos/

# --- tensors weights ---
*.ckpt
*.pt

openrouter-api-key


# --- runtime data written by the running stack (live databases and run output must never be committed) ---
