# Template for the shared .env for all vinu-components services (Docker:
# every service's docker-compose.yml block uses `env_file: .env` pointing
# there). Union of every variable declared across all services' own
# .env.example files.
# THIS FILE (.env-example) IS COMMITTED -- never put real secrets in it.
# Copy it to `.env` (gitignored) and fill in real values there instead.

# --- Shared provider credentials ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
POLYGON_API_KEY=
FMP_API_KEY=

# --- Shared local LLM (used by vinu-news, vinu-research, vinu-agent) ---
# Local OpenAI-compatible server running on the HOST at port 8009.
# host.docker.internal (not 127.0.0.1) is required so containers can
# reach it -- news-api, research-api, and agent-api all already have
# `extra_hosts: host.docker.internal:host-gateway` set in
# docker-compose.yml for exactly this. If running a service directly on
# the host (outside Docker) instead, override to http://127.0.0.1:8009/v1.
VINU_LLM_BASE_URL=http://host.docker.internal:8009/v1
VINU_LLM_MODEL=qwen36-35B
VINU_LLM_PROVIDER=openai
VINU_LLM_API_KEY=
VINU_LLM_MAX_TOKENS=8000
VINU_LLM_TTL_SEC=86400

# --- Optional: independent LLM for vinu-agent's orchestrator only ---
# Leave all of these unset and the orchestrator transparently shares the
# VINU_LLM_* config above with teams/specialists (today's default
# behavior). Set ANY one of these to opt the orchestrator into its own,
# separately-configured provider/model -- e.g. a real OpenAI account for
# the conversational front-door, while teams/specialists keep using the
# shared local model. Unset fields here fall back to plain defaults
# (provider=openai, model=gpt-4o-mini), not to the VINU_LLM_* values above
# -- mixing a shared local model name with a different provider would be
# silently wrong.
# VINU_ORCHESTRATOR_LLM_PROVIDER=openai
# VINU_ORCHESTRATOR_LLM_MODEL=gpt-4o
# VINU_ORCHESTRATOR_LLM_API_KEY=
# VINU_ORCHESTRATOR_LLM_BASE_URL=https://api.openai.com/v1
# VINU_ORCHESTRATOR_LLM_TIMEOUT=120
# VINU_ORCHESTRATOR_LLM_CONTEXT_WINDOW=0

# --- Shared watchlist ---
# `/shared/watchlist.json` in Docker -- news-api and stock-api both bind-mount
# `./data/shared:/shared` in docker-compose.yml. Left blank, `sync_watchlist_
# from_shared()`/`POST /news|stock/watchlist/sync` fail with "VINU_SHARED_
# WATCHLIST_PATH not set" instead of silently doing nothing -- confirmed the
# first time this template was used against a real Docker stack. If running
# a service directly on the host instead, override to the real path of
# `data/shared/watchlist.json`.
VINU_SHARED_WATCHLIST_PATH=/shared/watchlist.json

# --- Cross-service API URLs ---
# Docker Compose service-name hostnames (see docker-compose.yml's `services:`
# block) -- NOT 127.0.0.1. Inside a container, 127.0.0.1 means "myself," not
# another container; only the service DNS name reaches another container on
# the Compose network. If you ever run a component directly on the host
# (outside Docker) instead, override these back to http://127.0.0.1:<port>.
VINU_STOCK_API_URL=http://stock-api:8081
VINU_STOCK_PRICE_API_URL=http://stock-api:8081
VINU_NEWS_API_URL=http://news-api:8080
VINU_FEATURES_API_URL=http://features-api:8082
VINU_TOOLS_API_URL=http://features-api:8082
VINU_CORRELATION_API_URL=http://initial-analysis-api:8083
VINU_INITIAL_ANALYSIS_API_URL=http://initial-analysis-api:8083
VINU_STRATEGY_API_URL=http://strategy-api:8084
VINU_SIMULATOR_API_URL=http://simulator-api:8085
VINU_AGENT_API_URL=http://agent-api:8086
VINU_RESEARCH_API_URL=http://research-api:8087
VINU_PORTFOLIO_API_URL=http://portfolio-api:8090
VINU_LIVE_API_URL=http://live-api:8091

# --- vinu-news ---
# Data-root/db-path values below (this section through vinu-research) must be
# `/data`-rooted in Docker -- every service's container is `read_only: true`
# with only its own `./data/<service>:/data` bind mount (plus tmpfs /tmp,
# /home/app/.cache) writable, same reasoning as vinu-agent's entry below. A
# relative `../data/<service>/...` path resolves against the container's
# WORKDIR (e.g. `/app/vinu-news`), landing on the read-only root filesystem
# instead of the mounted volume -- confirmed by this exact crash
# (`OSError: [Errno 30] Read-only file system: '../data'`) the first time
# this template was used to actually build the Docker stack. If running a
# service directly on the host (outside Docker) instead, override back to
# the relative `../data/<service>/...` path each service's own
# `.env.example` documents.
VINU_NEWS_DATA_ROOT=/data
VINU_NEWS_STORAGE=sqlite
VINU_NEWS_HOST=0.0.0.0
VINU_NEWS_PORT=8080
VINU_NEWS_MODE=ticker
VINU_NEWS_POLL_INTERVAL_SEC=600
VINU_LLM_ANALYSIS_MODE=auto
VINU_LLM_ANALYSIS_CONCURRENCY=3
VINU_NEWS_ACTIVE_TIERS=1,2,3,4
VINU_NEWS_MAX_WORKERS=8

# --- vinu-stock-price ---
VINU_STOCK_DATA_ROOT=/data
VINU_STOCK_POLL_INTERVAL_SEC=60
VINU_STOCK_HOST=127.0.0.1
VINU_STOCK_PORT=8081
VINU_STOCK_DEFAULT_PROVIDER=alpaca

# --- vinu-tools (vinu-features) ---
VINU_FEATURES_DATA_DIR=/data
VINU_FEATURES_META_DB_PATH=/data/meta.db
VINU_FEATURES_HOST=127.0.0.1
VINU_FEATURES_PORT=8082

# --- vinu-initial-analysis (vinu-correlation) ---
# `VINU_CORRELATION_DATA_ROOT` (this template's previous name here) is not
# read anywhere in vinu_initial_analysis's code -- the real variable is
# `VINU_INITIAL_ANALYSIS_DATA_ROOT`. Renamed to match; harmless in practice
# so far only because the Dockerfile's own `/data` default was never
# actually overridden by the wrong name.
VINU_INITIAL_ANALYSIS_DATA_ROOT=/data
# Fixed origin date for the quarterly [start, Qn] analysis window --
# see New-talk-/Final-implementation/limitations_and_other_info.md #4.
# Never change this in a real deployment; it's what keeps every ticker's
# run comparable to every other ticker's run and to its own prior-quarter
# run, since they all share the same origin point.
# VINU_STAGE1_START_DATE=2022-01-01
# --- TEMPORARY override for the small E2E plumbing check only (see
# New-talk-/Final-implementation/04-first-small-E2E-check/plan.md) --
# a short ~2-week window instead of the full 2022-01-01-to-now history,
# so the check is fast to run. Revert to the real value above (uncomment
# it, delete/comment this line) before any real/production use.
# IMPORTANT: for the tier2 scheduler specifically, this must stay BEFORE
# the current quarter's start (see vinu-initial-analysis's quarters.py)
# -- the scheduler's window end is the quarter boundary, not "now", so a
# start date after that boundary produces an inverted [start, end] window
# and every scheduled run reports "no_data" (confirmed 2026-08-06).
# 2026-06-17 is ~2 weeks before Q3 2026's July 1 boundary -- update this
# alongside the quarter if re-run in a later quarter.
VINU_STAGE1_START_DATE=2026-06-17
# How often (in months) the tier2 scheduler's analysis window advances --
# see vinu-initial-analysis/vinu_initial_analysis/quarters.py. Must evenly
# divide 12 (1, 2, 3, 4, 6, or 12). Default 3 = standard calendar quarters,
# i.e. tier2 recomputes 12/3=4 times a year. Change here, not in code, if
# the cadence ever needs to be different.
VINU_TIER2_PERIOD_MONTHS=3
# Per-angle numeric setting overrides -- VINU_<ANGLE_NAME>_<SETTING_NAME>,
# uncommented here only as an example of the pattern (not exhaustive; every
# one of the 31 angles' own compute.py documents its own real default and
# env var name right next to its threshold constant). Most angles share
# DEFAULT_MIN_OBSERVATIONS=100 (config.py) unless they have a real,
# already-decided reason to differ (chronos=512, kronos=30, etc.) -- see
# New-talk-/06-implementation-of-each-angles/adding-a-new-angle.md for the
# full pattern and when to add a new one for a new angle.
# VINU_LSTM_MIN_OBSERVATIONS=100
# VINU_TIMESFM_MAX_CONTEXT=1024
VINU_CORRELATION_PORT=8083
VINU_CORRELATION_MARKET_HOURS_ONLY=true
VINU_CORRELATION_SESSION_BREAK_ON_CLOSE=true
VINU_CORRELATION_CACHE_TTL_SEC=300
VINU_CORRELATION_CACHE_MAXSIZE=128
VINU_CORRELATION_COMPUTE_POLL_INTERVAL_SEC=3600
VINU_CORRELATION_COMPACT_THRESHOLD=50
VINU_CORRELATION_IMPACT_HIGH_THRESHOLD=2.0
VINU_CORRELATION_IMPACT_MEDIUM_THRESHOLD=0.5
VINU_CORRELATION_DRAWDOWN_MIN_PCT=-3.0
VINU_CORRELATION_DRAWDOWN_LOOKBACK_HOURS=24
VINU_CORRELATION_BASELINE_WINDOW_DAYS=7

# --- vinu-strategy ---
VINU_STRATEGY_PORT=8084
VINU_STRATEGY_HOST=127.0.0.1
VINU_STRATEGY_DATA_ROOT=/data
VINU_STRATEGY_STRATEGIES_DIR=./strategies
VINU_STRATEGY_MAX_WEIGHT=0.25
VINU_STRATEGY_CASH_FLOOR=0.10
VINU_STRATEGY_REBALANCE_FREQ=daily

# --- vinu-simulator ---
VINU_SIMULATOR_HOST=127.0.0.1
VINU_SIMULATOR_PORT=8085
VINU_SIMULATOR_DATA_ROOT=/data
VINU_SIMULATOR_INITIAL_CAPITAL=1000000.0
VINU_SIMULATOR_TRANSACTION_COST_PCT=0.001
VINU_SIMULATOR_SLIPPAGE_PCT=0.0005
VINU_SIMULATOR_BENCHMARK_TICKERS=SPY,QQQ
VINU_SIMULATOR_ALLOW_SHORT=true
VINU_SIMULATOR_DEVIATION_THRESHOLD=0.05

# --- vinu-research ---
VINU_RESEARCH_PORT=8087
VINU_RESEARCH_HOST=127.0.0.1
VINU_RESEARCH_DATA_ROOT=/data
VINU_RESEARCH_LLM_ENABLED=true

# --- vinu-agent ---
# Must be /data in Docker -- agent-api's container is read_only: true with
# only /data (bind-mounted from ./data/agent) and tmpfs /tmp, /home/app/.cache
# writable. Without this set, config.py/kill_switch.py fall back to
# Path.home()/".vinu", which is not a writable mount and breaks session
# storage, the Facts Registry, and the trade-audit log on first write.
VINU_AGENT_DATA_ROOT=/data

# --- Debug (shared default across all services) ---
VINU_DEBUG=false
VINU_DEBUG_LEVEL=1
