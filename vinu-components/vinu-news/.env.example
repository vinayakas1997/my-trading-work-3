VINU_NEWS_DB_PATH=../data/news/news.db
VINU_NEWS_STORAGE=sqlite
VINU_NEWS_HOST=0.0.0.0
VINU_NEWS_PORT=8080

# Cross-service integration
VINU_STOCK_API_URL=http://127.0.0.1:8081
VINU_SHARED_WATCHLIST_PATH=

# Alpaca Markets API (historical news backfill)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Future: FMP ticker news / stock provider
FMP_API_KEY=

# --- Dynamic settings (DB takes precedence after first run) ---
# These set initial defaults when the DB is first created.
# Change them at runtime via PATCH /settings or CLI: vinu-news-query settings set <key> <value>

# Collection mode: "ticker" (watchlist-only) or "all" (everything)
VINU_NEWS_MODE=ticker
# Seconds between RSS poll cycles
VINU_NEWS_POLL_INTERVAL_SEC=600
# Comma-separated RSS tiers (1=wire, 2=finmedia, 3=blogs, 4=forums)
VINU_NEWS_ACTIVE_TIERS=1,2,3,4

# Max parallel feed fetch workers (default: 8, set to 1 for low-memory)
VINU_NEWS_MAX_WORKERS=8

# Debug
VINU_DEBUG=false
VINU_DEBUG_LEVEL=1
